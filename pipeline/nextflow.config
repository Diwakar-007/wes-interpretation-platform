// WES pipeline: FASTQ -> analysis-ready BAM -> filtered, normalised VCF
manifest {
    name            = 'wes-pipeline'
    description     = 'Germline WES: fastp, bwa mem, MarkDuplicates, BQSR, HaplotypeCaller (scattered), hard filters'
    version         = '0.1.0'
}

params {
    input            = null      // samplesheet CSV: sample,fastq_1,fastq_2
    outdir           = 'results'
    fasta            = null      // reference FASTA; needs .fai, .dict and bwa index next to it
    known_sites      = null      // comma-separated VCFs for BQSR (each needs a .tbi)
    intervals        = null      // capture target BED
    interval_padding = 100       // bp added around each target for calling
    scatter_count    = 4         // number of HaplotypeCaller shards
}

// Laptop limits: Nextflow never runs more tasks at once than fit in these
executor {
    name   = 'local'
    cpus   = 8
    memory = 11.GB
}

process {
    cpus   = 1
    memory = 2.GB
    errorStrategy = 'terminate'

    withLabel: 'process_low'    { cpus = 2; memory = 2.GB }
    withLabel: 'process_medium' { cpus = 2; memory = 4.GB }
    withLabel: 'process_high'   { cpus = 6; memory = 8.GB }
    withName:  'HAPLOTYPECALLER' { cpus = 2; memory = 3.GB }
}

workDir = "${System.getenv('HOME')}/ngs-data/work"

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }

profiles {
    // Use the 'ngs' conda env created by scripts/setup/01_install_tools.sh
    conda {
        conda.enabled  = true
        process.conda  = "${System.getenv('HOME')}/miniforge3/envs/ngs"
    }
    test   { includeConfig 'conf/test.config' }
    grch38 { includeConfig 'conf/grch38.config' }
    test_grch38 { includeConfig 'conf/test_grch38.config' }
}
