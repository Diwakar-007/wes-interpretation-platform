// nf-core test reads (from chr21) aligned to full GRCh38, calling restricted to chr21.
// Exercises the real reference, BWA index and known sites. Takes about 10-20 minutes.
// Usage: nextflow run main.nf -profile grch38,test_grch38,conda
params {
    input         = "${projectDir}/assets/samplesheet_test.csv"
    intervals     = "${projectDir}/assets/chr21.bed"
    scatter_count = 4
    outdir        = "${System.getenv('HOME')}/ngs-data/runs/test_grch38"
}
