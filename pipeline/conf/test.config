// Tiny chr22 test set from nf-core (runs in a few minutes)
// Usage: nextflow run main.nf -profile test,conda
params {
    input         = "${projectDir}/assets/samplesheet_test.csv"
    fasta         = "${System.getenv('HOME')}/ngs-data/test/ref/genome.fasta"
    known_sites   = "${System.getenv('HOME')}/ngs-data/test/ref/dbsnp_146.hg38.vcf.gz,${System.getenv('HOME')}/ngs-data/test/ref/mills_and_1000G.indels.vcf.gz"
    intervals     = "${System.getenv('HOME')}/ngs-data/test/ref/genome.bed"
    scatter_count = 2
    outdir        = "${System.getenv('HOME')}/ngs-data/runs/test"
}
