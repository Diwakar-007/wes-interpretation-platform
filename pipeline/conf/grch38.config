// Real exomes on GRCh38 (files from scripts/setup/03_download_grch38.sh)
// Usage: nextflow run main.nf -profile grch38,conda --input samples.csv --intervals capture_targets.bed --outdir ~/ngs-data/runs/<name>
params {
    fasta         = "${System.getenv('HOME')}/ngs-data/refs/GRCh38/Homo_sapiens_assembly38.fasta"
    known_sites   = "${System.getenv('HOME')}/ngs-data/refs/GRCh38/1000G_phase1.snps.high_confidence.hg38.vcf.gz,${System.getenv('HOME')}/ngs-data/refs/GRCh38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz,${System.getenv('HOME')}/ngs-data/refs/GRCh38/Homo_sapiens_assembly38.known_indels.vcf.gz"
    scatter_count = 6
}
